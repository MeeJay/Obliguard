# ── Image version (tag Docker Hub, ex: latest, 1.0.0) ──
OBLIGUARD_VERSION=latest

# ── Database ──
# If using the built-in postgres container (docker-compose.yml):
DB_PASSWORD=changeme

# If using an external PostgreSQL (docker-compose.external-db.yml):
# DATABASE_URL=postgres://obliguard:yourpassword@your-db-host:5432/obliguard

# ── Server ──
NODE_ENV=production
# REQUIRED. 32+ random characters, e.g. `openssl rand -hex 32` (install.sh generates it).
# In production the server refuses to start when it is missing, shorter than 32
# characters or a value published in this repository. It signs the sessions and,
# unless CREDENTIAL_ENCRYPTION_KEY is set, encrypts stored credentials.
# Production session cookies are always marked Secure: reach the UI through HTTPS
# (TLS reverse proxy sending X-Forwarded-Proto: https), plain-HTTP logins will not stick.
SESSION_SECRET=

# Optional dedicated key for stored credentials (MikroTik API passwords, M365
# certificates), e.g. `openssl rand -hex 32`. Existing values encrypted with the
# SESSION_SECRET key stay readable and are re-encrypted on their next write.
# Keep it: losing it makes those credentials unreadable.
# CREDENTIAL_ENCRYPTION_KEY=
# After rotating SESSION_SECRET, put the old value here so credentials encrypted
# under it remain readable until they are saved again.
# PREVIOUS_SESSION_SECRET=

# ── Client IP behind proxies ──
# The client container's nginx appends the address it saw to X-Forwarded-For; the
# server walks that list from the right, skipping trusted proxies.
# TRUSTED_PROXIES: comma-separated IPs, CIDRs or keywords (loopback, linklocal,
# uniquelocal, self). Default "loopback, self, 172.16.0.0/12": the client container
# and a reverse proxy running in Docker on the same host. Add a reverse proxy that
# runs elsewhere on the LAN (e.g. "loopback, self, 172.16.0.0/12, 192.168.1.10").
# TRUSTED_PROXIES=
# TRUSTED_PROXY_HOPS: how many X-Forwarded-For entries are consumed (1..10, default
# 2 = edge reverse proxy + the client container's nginx). Set 1 when LISTEN_PORT is
# reachable WITHOUT a reverse proxy in front: with 2 such a client could choose the
# address it is recorded with.
# TRUSTED_PROXY_HOPS=2
# Without Docker (bare-metal install) the "self" keyword covers the host's LAN
# subnets: set TRUSTED_PROXIES=loopback there (plus your reverse proxy address).

# ── Client origin (for CORS — set to your actual URL) ──
CLIENT_ORIGIN=http://localhost
LISTEN_PORT=3001

# ── Public URL of this instance (optional: CLIENT_ORIGIN is used when unset) ──
# Used for the Obligate SSO redirect_uri and e-mail links (APP_URL first, CLIENT_ORIGIN as
# fallback, as in Obliance). SSO only works on that hostname; list
# any other address users reach the app on (LAN IP, second DNS name) in
# SSO_ALLOWED_HOSTS: comma-separated "http(s)://host[:port]" (a bare "host[:port]" means https).
# APP_URL=https://guard.example.com
# SSO_ALLOWED_HOSTS=http://192.168.1.10:3001,guard.internal

# ── Ban safety ──
# Widest subnet a ban may cover (IPv4 /8..32, IPv6 /16..128). Manual subnet bans stay refused until agents enforce CIDR (lot D4.1).
BAN_MIN_PREFIX_V4=16
BAN_MIN_PREFIX_V6=48
# Extra addresses/subnets that must never be banned (public IP behind NAT, reverse proxy, Obligate host...). The hosts of APP_URL / CLIENT_ORIGIN / SSO_ALLOWED_HOSTS are always protected; the server's own interface addresses are protected against global bans.
# BAN_PROTECTED_IPS=203.0.113.10,198.51.100.0/28

# ── External bans (sibling apps such as Oblihub, via Obligate delegation tokens) ──
# Maximum duration of a pushed ban in seconds (default 604800 = 7 days). A push without
# banned_until gets this duration; it is never permanent.
# EXTERNAL_BAN_MAX_SECONDS=604800
# Issuer expected in delegation tokens. Defaults to the Obligate URL configured in
# Settings. Set it when Obliguard reaches Obligate on an internal URL while Obligate
# stamps its public URL (OBLIGATE_PUBLIC_URL) as iss: otherwise every external ban
# is refused with 401 wrong_issuer.
# OBLIGATE_ISSUER=https://obligate.example.com
# Temporary escape hatch: each delegation token is single-use by default. Set true only
# while a sibling app still reuses one token for several requests (older Oblihub).
# DELEGATION_ALLOW_JTI_REUSE=false

# ── App name (used as prefix in notification messages) ──
APP_NAME=Obliguard

# ── Default admin (created on first run, only when no admin exists) ──
# Use 12+ characters (install.sh generates one and prints it once). When unset the
# published default "admin123" is used and the server logs a warning on every boot
# until it is changed. Change it after the first login either way.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# ── Agent push interval limits (admin policy) ──
# Minimum allowed agent check interval in seconds (default: 10)
# MIN_CHECK_INTERVAL=10
# Minimum allowed agent retry interval in seconds (default: 5)
# MIN_RETRY_INTERVAL=5

# ── Agent enrolment ──
# Max devices waiting for approval per API key (new agents beyond it are not registered until the queue is processed). 0 = unlimited; empty = default 500.
# AGENT_MAX_PENDING_PER_KEY=500
# Device ↔ API-key binding. strict (default): a device answers only to the key it enrolled with (release it in Admin → Agents → Edit).
# tenant: any key of the device's tenant re-binds it (first-deploy / mass re-keying only). Cross-tenant and MikroTik refusals always apply.
# AGENT_KEY_BINDING=strict
# A device uuid is unique across tenants: if an agent is refused with a 403 and the server log shows
# "Agent refused: device/API-key mismatch" with keyTenantId ≠ deviceTenantId, another tenant's key enrolled that
# uuid first. A platform admin switches to the device's tenant (the Default tenant view is read-only) and deletes
# that row; the real agent then enrols on its next connection.

# ── Custom directory (scripts, SSH keys — persists across updates) ──
# Mounted at /custom inside the server container.
# Default: ./custom (next to your docker-compose.yml)
# Unraid example: CUSTOM_DIR=/mnt/user/appdata/obliguard/custom
# CUSTOM_DIR=./custom
