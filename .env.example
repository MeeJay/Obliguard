# ── Image version (tag Docker Hub, ex: latest, 1.0.0) ──
OBLIGUARD_VERSION=latest

# ── Database ──
# If using the built-in postgres container (docker-compose.yml):
DB_PASSWORD=changeme

# If using an external PostgreSQL (docker-compose.external-db.yml):
# DATABASE_URL=postgres://obliguard:yourpassword@your-db-host:5432/obliguard

# ── Server ──
NODE_ENV=production
SESSION_SECRET=change-this-to-a-random-secret

# ── Client origin (for CORS — set to your actual URL) ──
CLIENT_ORIGIN=http://localhost
LISTEN_PORT=3001

# ── Public URL of this instance (optional: CLIENT_ORIGIN is used when unset) ──
# Used for the Obligate SSO redirect_uri and e-mail links (APP_URL first, CLIENT_ORIGIN as
# fallback, as in Obliance). SSO only works on that hostname; list
# any other address users reach the app on (LAN IP, second DNS name) in
# SSO_ALLOWED_HOSTS: comma-separated "http(s)://host[:port]" (a bare "host[:port]" means https).
# APP_URL=https://guard.example.com
# SSO_ALLOWED_HOSTS=http://192.168.1.10:3001,guard.internal

# ── Ban safety ──
# Widest subnet a ban may cover (IPv4 /8..32, IPv6 /16..128). Manual subnet bans stay refused until agents enforce CIDR (lot D4.1).
BAN_MIN_PREFIX_V4=16
BAN_MIN_PREFIX_V6=48
# Extra addresses/subnets that must never be banned (public IP behind NAT, reverse proxy, Obligate host...). The hosts of APP_URL / CLIENT_ORIGIN / SSO_ALLOWED_HOSTS are always protected; the server's own interface addresses are protected against global bans.
# BAN_PROTECTED_IPS=203.0.113.10,198.51.100.0/28

# ── App name (used as prefix in notification messages) ──
APP_NAME=Obliguard

# ── Default admin (created on first run) ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── Agent push interval limits (admin policy) ──
# Minimum allowed agent check interval in seconds (default: 10)
# MIN_CHECK_INTERVAL=10
# Minimum allowed agent retry interval in seconds (default: 5)
# MIN_RETRY_INTERVAL=5

# ── Agent enrolment ──
# Max devices waiting for approval per API key (new agents beyond it are not registered until the queue is processed). 0 = unlimited; empty = default 500.
# AGENT_MAX_PENDING_PER_KEY=500
# Device ↔ API-key binding. strict (default): a device answers only to the key it enrolled with (release it in Admin → Agents → Edit).
# tenant: any key of the device's tenant re-binds it (first-deploy / mass re-keying only). Cross-tenant and MikroTik refusals always apply.
# AGENT_KEY_BINDING=strict
# A device uuid is unique across tenants: if an agent is refused with a 403 and the server log shows
# "Agent refused: device/API-key mismatch" with keyTenantId ≠ deviceTenantId, another tenant's key enrolled that
# uuid first. A platform admin switches to the device's tenant (the Default tenant view is read-only) and deletes
# that row; the real agent then enrols on its next connection.

# ── Custom directory (scripts, SSH keys — persists across updates) ──
# Mounted at /custom inside the server container.
# Default: ./custom (next to your docker-compose.yml)
# Unraid example: CUSTOM_DIR=/mnt/user/appdata/obliguard/custom
# CUSTOM_DIR=./custom
