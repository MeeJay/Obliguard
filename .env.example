# ── Image version (tag Docker Hub, ex: latest, 1.0.0) ──
OBLIGUARD_VERSION=latest

# ── Database ──
# If using the built-in postgres container (docker-compose.yml):
DB_PASSWORD=changeme

# If using an external PostgreSQL (docker-compose.external-db.yml):
# DATABASE_URL=postgres://obliguard:yourpassword@your-db-host:5432/obliguard

# ── Server ──
NODE_ENV=production
SESSION_SECRET=change-this-to-a-random-secret

# ── Client origin (for CORS — set to your actual URL) ──
CLIENT_ORIGIN=http://localhost
LISTEN_PORT=3001

# ── Public URL of this instance (recommended) ──
# Used for the Obligate SSO redirect_uri and e-mail links. When APP_URL or a
# non-localhost CLIENT_ORIGIN is set, SSO only works on these hostnames; list
# any other address users reach the app on (LAN IP, second DNS name) in
# SSO_ALLOWED_HOSTS: comma-separated "http(s)://host[:port]" (a bare "host[:port]" means https).
# APP_URL=https://guard.example.com
# SSO_ALLOWED_HOSTS=http://192.168.1.10:3001,guard.internal

# ── App name (used as prefix in notification messages) ──
APP_NAME=Obliguard

# ── Default admin (created on first run) ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── Agent push interval limits (admin policy) ──
# Minimum allowed agent check interval in seconds (default: 10)
# MIN_CHECK_INTERVAL=10
# Minimum allowed agent retry interval in seconds (default: 5)
# MIN_RETRY_INTERVAL=5

# ── Custom directory (scripts, SSH keys — persists across updates) ──
# Mounted at /custom inside the server container.
# Default: ./custom (next to your docker-compose.yml)
# Unraid example: CUSTOM_DIR=/mnt/user/appdata/obliguard/custom
# CUSTOM_DIR=./custom
